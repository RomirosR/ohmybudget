# Скопируйте на сервер как .env.prod рядом с docker-compose.yml.
# docker compose --env-file .env.prod -f docker-compose.yml -f docker-compose.prod.yml up -d --build

POSTGRES_PASSWORD=change-me-strong-password
JWT_SECRET=change-me-long-random-string-min-32-chars

# Email verification (Yandex Cloud Postbox)
APP_PUBLIC_URL=https://ohmybudget.by
EMAIL_TRANSPORT=smtp
EMAIL_FROM=noreply@ohmybudget.by
SMTP_HOST=postbox.cloud.yandex.net
SMTP_PORT=587
SMTP_USER=change-me-postbox-api-key-id
SMTP_PASSWORD=change-me-postbox-api-key-secret
