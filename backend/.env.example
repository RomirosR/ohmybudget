# Скопируйте в backend/.env и при необходимости измените значения.

# Локально по умолчанию — SQLite (файл backend/ohmybudget.db).
# Docker Compose — PostgreSQL (см. docker-compose.yml).
# DATABASE_URL=sqlite:///./ohmybudget.db
# DATABASE_URL=postgresql+psycopg://ohmybudget:ohmybudget@localhost:5432/ohmybudget

# JWT (обязателен в production; для dev есть fallback в config.py)
# JWT_SECRET=change-me-in-production
# JWT_EXPIRE_MINUTES=10080

# Публичный URL фронта (ссылки подтверждения email)
# APP_PUBLIC_URL=http://localhost:5173

# Почта: console (dev, письмо в лог) или smtp (Yandex Cloud Postbox)
# EMAIL_TRANSPORT=console
# EMAIL_FROM=noreply@ohmybudget.by
# SMTP_HOST=postbox.cloud.yandex.net
# SMTP_PORT=587
# SMTP_USER=<postbox-api-key-id>
# SMTP_PASSWORD=<postbox-api-key-secret>
# EMAIL_VERIFY_EXPIRE_HOURS=24
