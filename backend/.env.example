# Скопируйте в backend/.env и при необходимости измените значения.

# Локально по умолчанию — SQLite (файл backend/ohmybudget.db).
# Docker Compose — PostgreSQL (см. docker-compose.yml).
# DATABASE_URL=sqlite:///./ohmybudget.db
# DATABASE_URL=postgresql+psycopg://ohmybudget:ohmybudget@localhost:5432/ohmybudget

# JWT (обязателен в production; для dev есть fallback в config.py)
# JWT_SECRET=change-me-in-production
# JWT_EXPIRE_MINUTES=10080
